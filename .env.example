# Copy this file to .env and fill in your key.
# .env is gitignored. For a real install, prefer Windows Credential Manager:
#     python scripts/set_key.py
# which stores the key encrypted per-user instead of in a plaintext file.

# ORBIT_API_KEY works with any configured OpenAI-compatible provider.
# OPENAI_API_KEY remains supported for existing installs.
ORBIT_API_KEY=your-provider-key

# Optional overrides (defaults live in src/orbit/config.py)
# ORBIT_STT_MODEL=gpt-4o-mini-transcribe
# ORBIT_LLM_MODEL=gpt-4o-mini
