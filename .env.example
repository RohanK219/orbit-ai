# Copy this file to .env and fill in your key.
# .env is gitignored. For a real install, prefer Windows Credential Manager:
#     python scripts/set_key.py
# which stores the key encrypted per-user instead of in a plaintext file.

OPENAI_API_KEY=sk-your-key-here

